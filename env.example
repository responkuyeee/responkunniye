# =========================================
# APP
# =========================================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# =========================================
# DATABASE
# =========================================
DATABASE_URL=postgresql://user:password@localhost:5432/marketplace_responden
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# =========================================
# AUTH
# =========================================
JWT_SECRET=changeme_generate_a_strong_random_secret
JWT_EXPIRES_IN=7d

# =========================================
# OTP PROVIDER (email & SMS)
# =========================================
OTP_EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

OTP_SMS_PROVIDER=zenziva   # atau twilio, dsb
OTP_SMS_API_KEY=
OTP_SMS_API_SECRET=

# =========================================
# PAYMENT GATEWAY (Midtrans / Xendit)
# =========================================
PAYMENT_PROVIDER=midtrans   # atau xendit
PAYMENT_SERVER_KEY=
PAYMENT_CLIENT_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_IS_PRODUCTION=false

# CATATAN: sementara masih pakai akun pribadi (bukan PT/CV),
# perhatikan limit transaksi bulanan dari provider — lihat architecture.md

# =========================================
# FILE / GPS STORAGE (S3-compatible)
# =========================================
STORAGE_PROVIDER=cloudflare_r2
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_REGION=auto

# =========================================
# BUSINESS RULES (config, JANGAN hardcode di kode — lihat skill.md)
# =========================================
TOKEN_PRICE_IDR=1000
REWARD_SPLIT_RESPONDENT_PERCENT=80
REWARD_SPLIT_PLATFORM_PERCENT=20
MIN_RESPONDENT_PER_RESEARCH=50
WITHDRAWAL_FEE_PERCENT=3
TOKEN_EXPIRY_IDLE_MONTHS=3
QUALITY_HOLD_RELEASE_HOURS=24
ADMIN_REVIEW_SLA_HOURS=48
CONTENT_REPORT_SLA_HOURS=48
CONSECUTIVE_GOOD_ANSWERS_FOR_RECOVERY=5   # ASSUMPTION, lihat PRD.md §6

# =========================================
# MONITORING / LOGGING (opsional MVP, isi kalau sudah dipakai)
# =========================================
SENTRY_DSN=
LOG_LEVEL=info
